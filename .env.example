# Google AI Studio key (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Live model used for real-time transcription
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Any PostgreSQL database (local, Docker, Neon, Supabase, RDS ...)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/speech_to_text

PORT=3000
